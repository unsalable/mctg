{
  "name": "mctg-launcher",
  "version": "1.0.0",
  "description": "Modern, animasyonlu Minecraft launcher",
  "main": "./out/main/index.js",
  "author": "melik",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/unsalable/mctg.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.33.0",
    "msmc": "^5.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "skinview3d": "^3.4.2",
    "undici": "7.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.mctg.launcher",
    "productName": "MCTG Launcher",
    "copyright": "Copyright © 2026 MCTG",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "unsalable",
        "repo": "mctg",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/mctg-icon.ico",
      "artifactName": "MCTG-Launcher-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MCTG Launcher",
      "uninstallDisplayName": "MCTG Launcher ${version}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build-resources/mctg-icon.ico",
      "uninstallerIcon": "build-resources/mctg-icon.ico"
    }
  }
}
